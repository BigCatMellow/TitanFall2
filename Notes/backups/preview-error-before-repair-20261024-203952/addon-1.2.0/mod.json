{
  "Name": "James.LocalPersistence",
  "Description": "Saves local human loadouts and basic XP; synchronizes client/menu caches after restore.",
  "Version": "1.2.0",
  "ConVars": [{"Name":"james_local_loadouts","DefaultValue":"1"}],
  "LoadPriority": 10,
  "Scripts": [
    {"Path":"james_local_persistence_paths.nut","RunOn":"SERVER || CLIENT || UI"},
    {"Path":"james_local_persistence.nut","RunOn":"SERVER && MP","ServerCallback":{"After":"JamesLocalPersistence_Init"}},
    {"Path":"james_local_persistence_client.nut","RunOn":"CLIENT && MP","ClientCallback":{"After":"JamesLocalPersistence_ClientInit"}},
    {"Path":"james_local_persistence_ui.nut","RunOn":"UI"}
  ],
  "PluginDependencies": ["BP_ORT"]
}
