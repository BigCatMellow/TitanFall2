{
  "Name": "BT7274.LocalPersistence",
  "Description": "Saves local human loadouts and basic XP; synchronizes client/menu caches after restore.",
  "Version": "1.2.1",
  "ConVars": [{"Name":"bt7274_local_loadouts","DefaultValue":"1"}],
  "LoadPriority": 10,
  "Scripts": [
    {"Path":"bt7274_local_persistence_paths.nut","RunOn":"SERVER || CLIENT || UI"},
    {"Path":"bt7274_local_persistence.nut","RunOn":"SERVER && MP","ServerCallback":{"After":"BT7274LocalPersistence_Init"}},
    {"Path":"bt7274_local_persistence_client.nut","RunOn":"CLIENT && MP","ClientCallback":{"After":"BT7274LocalPersistence_ClientInit"}},
    {"Path":"bt7274_local_persistence_ui.nut","RunOn":"UI"}
  ],
  "PluginDependencies": ["BP_ORT"]
}
